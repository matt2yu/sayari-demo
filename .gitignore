# Sayari's own interview materials. Their process, not ours to publish: the
# repo link goes to the interview team, it should not double as a public copy
# of their assessment.
FDE_Assessment_Instructions.pdf
Sayari_Interview_Exercise_List.xlsx

# The write-up. Committed only when the submission is ready.
report/

# Credentials — never commit
.env
.env.local
*.pem

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Node
node_modules/
frontend/dist/
*.tsbuildinfo
npm-debug.log*

# Pipeline output — generated, can be large.
# A committed sample lives at backend/snapshots/sample.snapshot.json so the
# frontend runs without API credentials.
backend/snapshots/*.json
!backend/snapshots/sample.snapshot.json

# Cached external list downloads (OFAC SDN etc.)
backend/pipeline/cache/

# OS / editor
.DS_Store
.idea/
.vscode/

# Pipeline stage artifacts (intermediate; regenerated by pipeline.run)
backend/snapshots/stages/
report/
